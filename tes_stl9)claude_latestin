    def calculate_bending_instructions(self):
        """Calculate wire bending instructions for lingual placement."""
        print(f"\n{'─'*50}")
        print("LINGUAL BENDING INSTRUCTIONS CALCULATION")
        print(f"{'─'*50}")
        
        if not self.bracket_positions:
            return []
        
        instructions = []
        cumulative_feed = 0.0
        
        # Get bracket positions in wire order
        bracket_positions_ordered = []
        for bracket in self.bracket_positions:
            # Find closest wire path point
            min_dist = float('inf')
            closest_idx = -1
            
            for i, path_point in enumerate(self.wire_path):
                dist = np.linalg.norm(path_point['position'] - bracket['position'])
                if dist < min_dist:
                    min_dist = dist
                    closest_idx = i
            
            if closest_idx >= 0:
                bracket_positions_ordered.append({
                    'bracket': bracket,
                    'wire_index': closest_idx
                })
        
        # Sort by wire index
        bracket_positions_ordered.sort(key=lambda x: x['wire_index'])
        
        # Calculate instructions for each bracket
        for i in range(len(bracket_positions_ordered)):
            bracket_info = bracket_positions_ordered[i]
            bracket = bracket_info['bracket']
            position = bracket['position']
            
            # Feed distance
            if i > 0:
                prev_pos = bracket_positions_ordered[i-1]['bracket']['position']
                segment_length = np.linalg.norm(position - prev_pos)
                cumulative_feed += segment_length
            
            # Bend angle
            bend_angle = 0.0
            if 0 < i < len(bracket_positions_ordered) - 1:
                p1 = bracket_positions_ordered[i-1]['bracket']['position']
                p2 = position
                p3 = bracket_positions_ordered[i+1]['bracket']['position']
                
                v1 = p1 - p2
                v2 = p3 - p2
                
                v1_norm = v1 / (np.linalg.norm(v1) + 1e-8)
                v2_norm = v2 / (np.linalg.norm(v2) + 1e-8)
                
                dot_product = np.clip(np.dot(v1_norm, v2_norm), -1, 1)
                angle_rad = np.arccos(dot_product)
                bend_angle = np.degrees(angle_rad)
                
                # Determine direction
                cross = np.cross(v1_norm, v2_norm)
                if cross[self.height_axis] < 0:
                    bend_angle = -bend_angle
            
            instructions.append({
                'index': i,
                'feed_distance': cumulative_feed,
                'bend_angle': bend_angle,
                'position': position.tolist(),
                'tooth_type': bracket['tooth_type'],
                'surface': 'lingual',
                'at_bracket': True
            })
        
        print(f"✓ Generated {len(instructions)} lingual bending instructions")
        
        return instructions
    
    def generate_lingual_wire(self):
        """Main method to generate lingual orthodontic wire."""
        
        # Step 1: Load mesh
        if not self.load_mesh():
